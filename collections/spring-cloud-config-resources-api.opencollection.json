{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Cloud Config Server Configuration Resources API",
    "version": "4.1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a resource file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8888/:application/:profile/:label/:path",
            "params": [
              {
                "name": "application",
                "value": "",
                "type": "path"
              },
              {
                "name": "profile",
                "value": "",
                "type": "path"
              },
              {
                "name": "label",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path",
                "description": "Path to the resource file in the repository"
              }
            ]
          },
          "docs": "Serves a plain text resource file from the configuration repository (e.g., nginx.conf, logback.xml). The path is resolved relative to the repository root for the specified label."
        }
      ]
    }
  ],
  "bundled": true
}